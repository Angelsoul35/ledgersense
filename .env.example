# Copy to .env and adjust. All variables are optional; defaults are safe for local use.

# Minimum absolute amount (in cents) for an entry to be considered by the
# anomaly detector. Tiny postings are ignored as noise.
LG_ANOMALY_MIN_CENTS=1000

# Robust z-score above which a posting is flagged as an amount anomaly.
LG_ANOMALY_Z_THRESHOLD=3.5

# Confidence below which the categoriser routes a transaction to manual review
# instead of auto-assigning an account.
LG_CATEGORISER_MIN_CONFIDENCE=0.45
